{
  "name": "afterclose",
  "version": "0.1.0",
  "private": true,
  "description": "Independent read-only tokenized-stock evidence research with canonical receipts and a synthetic Scenario Lab.",
  "repository": { "type": "git", "url": "https://github.com/chyokore/afterclose.git" },
  "homepage": "https://afterclose-preview.pages.dev/",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-live-safe.mjs",
    "build:live-safe": "node scripts/build-live-safe.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:api": "node --conditions=react-server --import tsx scripts/test-api.ts",
    "build:cloudflare": "opennextjs-cloudflare build",
    "build:static": "node scripts/build-static-preview.mjs",
    "build:public": "node scripts/build-static-preview.mjs && node scripts/build-public-live.mjs",
    "test:release": "node scripts/build-static-preview.mjs && node --conditions=react-server --import tsx --test tests/*.test.ts static-preview/model.test.ts static-preview/output.test.mjs"
  },
  "dependencies": {
    "@next/env": "16.3.8",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "@opennextjs/cloudflare": "1.20.8",
    "wrangler": "4.147.0",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
