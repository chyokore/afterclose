BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_WEB3_BASE_URL=https://web3.binance.com/build

# BSC chain 56 is validated in source; no public chain environment variable is used.
# Required for a local Next.js production-mode live server (not the static frontend):
# AFTERCLOSE_DEPLOYMENT_MODE=competition-live

# Optional local synthetic mode (leave UNSET for local live development):
# AFTERCLOSE_PREVIEW_MODE=synthetic
